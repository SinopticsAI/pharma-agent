# Copy to .env for local `mastra dev`. In the cloud these come from Lockbox.

# Agent memory: database pharma_agent in the managed cluster, pooler port.
PG_HOST=c-c9qbferg3hcqjnqkghcp.rw.mdb.yandexcloud.net
PG_PORT=6432
PG_DATABASE=pharma_agent
PG_USER=pharma_agent
PG_PASSWORD=
PG_SSLMODE=verify-full

# Business data goes through Edge, never straight to pharma_cabinet.
EDGE_API_BASE=https://pharma-edge.sinoptics.ru
EDGE_API_KEY=

# Yandex AI Studio, the same endpoint the Plane pipeline uses.
AI_STUDIO_BASE_URL=https://llm.api.cloud.yandex.net/v1
AI_STUDIO_API_KEY=
FOLDER_ID=b1g07nbj3q7ccru38on0
AGENT_MODEL=qwen3.6-35b-a3b

AGENT_CORS_ORIGINS=http://localhost:5173,http://localhost:5175

# Local development only. In the cloud the gateway authorizer supplies identity
# and these are ignored.
AGENT_DEV_ACCOUNT_ID=
AGENT_DEV_SUBJECT=
AGENT_DEV_ROLE=client
